# HeatVision configuration.
#
# The project runs end to end with NO secrets at all: the simulator, the
# detector and the evaluation need nothing from this file. Everything below is
# optional and only applies when you point the pipeline at real hardware or at
# the optional narration step of the demo recorder.
#
# Copy to .env and fill in locally. .env is git-ignored. Never commit real
# values, keys or tokens.

# ---------------------------------------------------------------- sensors
# GigE / USB index or RTSP URL of the colour camera on the sort line.
HEATVISION_RGB_SOURCE=0
# LWIR camera source (e.g. a FLIR Lepton on /dev/video2, or an RTSP URL).
HEATVISION_LWIR_SOURCE=2
# Path to the RGB<->LWIR homography produced by tools/calibrate.py.
HEATVISION_REGISTRATION=calib/registration.npy

# ------------------------------------------------------------------- cell
# Robot controller endpoint. Leave blank to stay in simulation.
HEATVISION_ROBOT_HOST=
HEATVISION_ROBOT_PORT=
# Belt encoder / PLC endpoint used to read true line speed.
HEATVISION_PLC_HOST=

# ---------------------------------------------------------------- runtime
HEATVISION_CHECKPOINT=runs/fused/heatnet_s.pt
HEATVISION_LOG_DIR=logs
# Torch thread count; keep low on a shared machine.
OMP_NUM_THREADS=6

# ------------------------------------------------------- demo narration
# Optional. Only read by scripts/record_demo.py for the voice-over.
EDGE_TTS_VOICE=en-US-AndrewNeural
